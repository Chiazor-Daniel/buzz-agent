#!/usr/bin/env bash
# Shared boot for buzz / buzz-code:
#   - prints the buzz banner (TTY only; disable with BUZZ_NO_BANNER=1)
#   - ensures the key-hiding NVIDIA proxy is running
#   - then hand off to pi

set -euo pipefail

PROXY_URL="${NVIDIA_PROXY_URL:-http://127.0.0.1:8888}"
BUZZ_ENGINE="${BUZZ_ENGINE:-NVIDIA Nemotron Lightning}"

CYAN=$'\033[0;96m'; BOLD=$'\033[1m'; DIM=$'\033[2m'; GREEN=$'\033[0;32m'
YELLOW=$'\033[0;33m'; RED=$'\033[0;31m'; NC=$'\033[0m'

is_subcommand() {
  case "${1:-}" in
    update|install|remove|uninstall|list|config|auth|show|get|set|onboard)
      return 0 ;;
    -h|--help|-V|--version)
      return 0 ;;
  esac
  return 1
}

show_banner() {
  [ "${BUZZ_NO_BANNER:-0}" = "1" ] && return 0
  [ -t 1 ] || return 0
  cat <<EOF
${CYAN}${BOLD}
  ██████╗ ██╗   ██╗███████╗███████╗
  ██╔══██╗██║   ██║╚══███╔╝╚══███╔╝
  ██████╔╝██║   ██║  ███╔╝   ███╔╝
  ██╔══██╗██║   ██║ ███╔╝   ███╔╝
  ██████╔╝╚██████╔╝███████╗███████╗
  ╚═════╝  ╚═════╝ ╚══════╝╚══════╝${NC}
${DIM}──────────────────────────────────────────────────${NC}
${GREEN}${BOLD}your AI coding agent${NC}  ·  engine: ${YELLOW}${BUZZ_ENGINE}${NC}
tools: ${DIM}read · bash · edit · write · grep · find · ls${NC}
EOF
}

ensure_proxy() {
  local proxy_dir
  if curl -sf -m 2 "$PROXY_URL/health" >/dev/null 2>&1; then
    return 0
  fi
  proxy_dir="$HOME/bin/nvidia-proxy"
  if [ ! -f "$proxy_dir/main.py" ]; then
    local self_dir
    self_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/nvidia-proxy" && pwd)"
    if [ -f "$self_dir/main.py" ]; then
      proxy_dir="$self_dir"
    fi
  fi
  if [ ! -f "$proxy_dir/main.py" ]; then
    echo "ERROR: nvidia-proxy not found. Run setup.sh first." >&2
    exit 1
  fi
  if [ ! -f "$HOME/.config/nvidia/api.key" ]; then
    echo "${RED}ERROR: no API key found. Run setup.sh (or save one to ~/.config/nvidia/api.key).${NC}" >&2
    exit 1
  fi
  if [ -t 2 ]; then
    echo "${DIM}starting key-hiding proxy on ${PROXY_URL} ...${NC}" >&2
  fi
  local py="python3"
  if [ -x "$HOME/.buzz-proxy-venv/bin/python" ]; then
    py="$HOME/.buzz-proxy-venv/bin/python"
  fi
  (nohup "$py" "$proxy_dir/main.py" >"$HOME/.config/nvidia/proxy.log" 2>&1 &)
  local i
  for i in $(seq 1 20); do
    if curl -sf -m 2 "$PROXY_URL/health" >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.5
  done
  echo "${RED}ERROR: proxy failed to start. See $HOME/.config/nvidia/proxy.log${NC}" >&2
  exit 1
}